<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-05-18T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram name="流媒体传输示意图" id="streaming_media_flow">
    <mxGraphModel dx="1200" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Top-Left: THE STREAMING PROVIDER -->
        <mxCell id="tl" value="THE&lt;br&gt;STREAMING&lt;br&gt;PROVIDER" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="195" y="115" width="170" height="170" as="geometry"/>
        </mxCell>

        <!-- Top-Right: THE USER -->
        <mxCell id="tr" value="THE USER" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="835" y="115" width="170" height="170" as="geometry"/>
        </mxCell>

        <!-- Bottom-Left: THE DATABASE -->
        <mxCell id="bl" value="THE&lt;br&gt;DATABASE" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="195" y="535" width="170" height="170" as="geometry"/>
        </mxCell>

        <!-- Bottom-Right: THE DEVICE AND SOFTWARE -->
        <mxCell id="br_cell" value="THE DEVICE&lt;br&gt;AND&lt;br&gt;SOFTWARE" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="835" y="535" width="170" height="170" as="geometry"/>
        </mxCell>

        <!-- Data arrow: left-pointing, USER → STREAMING PROVIDER -->
        <mxCell id="data_edge" value="Data" style="html=1;strokeWidth=26;strokeColor=#000000;endArrow=block;endFill=1;fontColor=#FFFFFF;fontSize=18;fontFamily=Helvetica;labelBackgroundColor=#000000;exitX=0;exitY=0.33;exitDx=0;exitDy=0;entryX=1;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="tr" target="tl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Payment arrow: left-pointing, USER → STREAMING PROVIDER -->
        <mxCell id="payment_edge" value="Payment" style="html=1;strokeWidth=26;strokeColor=#000000;endArrow=block;endFill=1;fontColor=#FFFFFF;fontSize=18;fontFamily=Helvetica;labelBackgroundColor=#000000;exitX=0;exitY=0.67;exitDx=0;exitDy=0;entryX=1;entryY=0.67;entryDx=0;entryDy=0;" edge="1" parent="1" source="tr" target="tl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Content arrow: right-pointing, DATABASE → DEVICE AND SOFTWARE -->
        <mxCell id="content_edge" value="Content" style="html=1;strokeWidth=26;strokeColor=#000000;endArrow=block;endFill=1;fontColor=#FFFFFF;fontSize=18;fontFamily=Helvetica;labelBackgroundColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bl" target="br_cell">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Control dashed arrow: downward, STREAMING PROVIDER → DATABASE -->
        <mxCell id="control_edge" value="Control" style="html=1;strokeWidth=2;strokeColor=#000000;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;endSize=14;fontColor=#000000;fontSize=18;fontFamily=Helvetica;fontStyle=2;labelBackgroundColor=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tl" target="bl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Access dashed arrow: downward, USER → DEVICE AND SOFTWARE -->
        <mxCell id="access_edge" value="Access" style="html=1;strokeWidth=2;strokeColor=#000000;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;endSize=14;fontColor=#000000;fontSize=18;fontFamily=Helvetica;fontStyle=2;labelBackgroundColor=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tr" target="br_cell">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
